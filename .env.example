# Admin access
ADMIN_PASSCODE=replace-with-a-long-random-passcode

# Server settings
PORT=3000
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:3000

# Gmail email verification (use a Google App Password, never your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=

# Stripe payments (leave blank to disable payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
